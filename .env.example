# ────────────────────────────────────────────────────────────
# Sunshine & Flip Flops — environment variables
# Copy to .env.local and fill in. .env.local is gitignored.
# NOTHING in this project is hardcoded — all secrets live here.
# ────────────────────────────────────────────────────────────

# Supabase public client config.
# The anon/publishable key is safe to expose to the browser — Row Level
# Security protects the data. Pull these from the Supabase dashboard
# (Project Settings → API) or via `supabase` MCP.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. NEVER prefixed with NEXT_PUBLIC, never sent to the browser,
# never committed. Used by the gated signup route to create the two admin
# accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails permitted to create / use Mary's Studio.
# Server-only — read in middleware + the signup route. Kept out of the repo.
ALLOWED_ADMIN_EMAILS=email-one@example.com,email-two@example.com
